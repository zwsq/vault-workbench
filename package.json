{
  "name": "vault-workbench",
  "displayName": "Vault Workbench",
  "description": "Vault Workbench: browse, search, edit, and batch search-and-replace HashiCorp Vault KV secrets. Fully local, no telemetry.",
  "version": "0.6.0",
  "publisher": "zwsq",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zwsq/vault-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/zwsq/vault-workbench/issues"
  },
  "homepage": "https://github.com/zwsq/vault-workbench#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vault",
    "hashicorp vault",
    "vault workbench",
    "secrets",
    "secrets management",
    "vault search",
    "vault replace",
    "vault batch replace",
    "batch replace",
    "search and replace",
    "find and replace",
    "kv",
    "kv v2",
    "hcp vault"
  ],
  "galleryBanner": {
    "color": "#1c1c1c",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "resourceLabelFormatters": [
      {
        "scheme": "vault",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "Vault"
        }
      },
      {
        "scheme": "vault-preview",
        "formatting": {
          "label": "${path} (proposed)",
          "separator": "/",
          "stripPathStartingSeparator": true,
          "workspaceSuffix": "Vault"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vaultExplorerContainer",
          "title": "Vault",
          "icon": "media/vault.svg"
        }
      ]
    },
    "views": {
      "vaultExplorerContainer": [
        {
          "id": "vaultExplorer",
          "name": "Vault Explorer",
          "icon": "media/vault.svg"
        },
        {
          "id": "vaultSearch",
          "name": "Search & Replace",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vaultExplorer",
        "contents": "No Vault connections yet.\n[Add Connection](command:vault.addConnection)\n[Add Group](command:vault.addGroup)\nConnections are stored locally and never synced."
      }
    ],
    "commands": [
      {
        "command": "vault.addConnection",
        "title": "Add Connection — Vault",
        "icon": "$(add)"
      },
      {
        "command": "vault.addGroup",
        "title": "Add Group — Vault",
        "icon": "$(new-folder)"
      },
      {
        "command": "vault.renameGroup",
        "title": "Rename Group — Vault",
        "icon": "$(edit)"
      },
      {
        "command": "vault.deleteGroup",
        "title": "Delete Group — Vault",
        "icon": "$(trash)"
      },
      {
        "command": "vault.moveConnectionToGroup",
        "title": "Move to Group… — Vault",
        "icon": "$(folder)"
      },
      {
        "command": "vault.moveUp",
        "title": "Move Up — Vault",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vault.moveDown",
        "title": "Move Down — Vault",
        "icon": "$(arrow-down)"
      },
      {
        "command": "vault.editConnection",
        "title": "Edit Connection — Vault",
        "icon": "$(edit)"
      },
      {
        "command": "vault.deleteConnection",
        "title": "Delete Connection — Vault",
        "icon": "$(trash)"
      },
      {
        "command": "vault.setToken",
        "title": "Set Token — Vault",
        "icon": "$(key)"
      },
      {
        "command": "vault.refresh",
        "title": "Refresh — Vault",
        "icon": "$(refresh)"
      },
      {
        "command": "vault.openSecret",
        "title": "Open Secret — Vault"
      },
      {
        "command": "vault.newSecret",
        "title": "New Secret — Vault",
        "icon": "$(new-file)"
      },
      {
        "command": "vault.deleteSecret",
        "title": "Delete Secret — Vault",
        "icon": "$(trash)"
      },
      {
        "command": "vault.deletePath",
        "title": "Delete — Vault",
        "icon": "$(trash)"
      },
      {
        "command": "vault.renamePath",
        "title": "Rename — Vault",
        "icon": "$(edit)"
      },
      {
        "command": "vault.copyPath",
        "title": "Copy Path — Vault"
      },
      {
        "command": "vault.copyTo",
        "title": "Copy To… — Vault",
        "icon": "$(copy)"
      },
      {
        "command": "vault.addToCompare",
        "title": "Add to Compare — Vault",
        "icon": "$(add)"
      },
      {
        "command": "vault.compareSelected",
        "title": "Compare Selected — Vault",
        "icon": "$(diff)"
      },
      {
        "command": "vault.clearCompare",
        "title": "Clear Compare — Vault",
        "icon": "$(clear-all)"
      },
      {
        "command": "vault.downloadPath",
        "title": "Download Path — Vault"
      },
      {
        "command": "vault.searchHere",
        "title": "Search In This Path — Vault",
        "icon": "$(search)"
      },
      {
        "command": "vault.focusSearch",
        "title": "Focus Search Panel — Vault"
      },
      {
        "command": "vault.restoreBackup",
        "title": "Restore Backup — Vault"
      },
      {
        "command": "vault.exportResultsJson",
        "title": "Export Search Results (JSON) — Vault"
      },
      {
        "command": "vault.exportResultsCsv",
        "title": "Export Search Results (CSV) — Vault"
      },
      {
        "command": "vault.showLog",
        "title": "Show Log — Vault"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vault.addConnection",
          "when": "view == vaultExplorer",
          "group": "navigation@1"
        },
        {
          "command": "vault.addGroup",
          "when": "view == vaultExplorer",
          "group": "navigation@2"
        },
        {
          "command": "vault.refresh",
          "when": "view == vaultExplorer",
          "group": "navigation@3"
        },
        {
          "command": "vault.compareSelected",
          "when": "view == vaultExplorer && vault.compareReady",
          "group": "navigation@4"
        },
        {
          "command": "vault.clearCompare",
          "when": "view == vaultExplorer && vault.compareCount > 0",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "vault.addConnection",
          "when": "view == vaultExplorer && viewItem == vaultGroup",
          "group": "1_group@1"
        },
        {
          "command": "vault.renameGroup",
          "when": "view == vaultExplorer && viewItem == vaultGroup",
          "group": "1_group@2"
        },
        {
          "command": "vault.deleteGroup",
          "when": "view == vaultExplorer && viewItem == vaultGroup",
          "group": "1_group@3"
        },
        {
          "command": "vault.setToken",
          "when": "view == vaultExplorer && viewItem == vaultConnection",
          "group": "1_auth@1"
        },
        {
          "command": "vault.editConnection",
          "when": "view == vaultExplorer && viewItem == vaultConnection",
          "group": "2_manage@1"
        },
        {
          "command": "vault.moveConnectionToGroup",
          "when": "view == vaultExplorer && viewItem == vaultConnection",
          "group": "2_manage@2"
        },
        {
          "command": "vault.moveUp",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Group|Connection)$/",
          "group": "2_manage@3"
        },
        {
          "command": "vault.moveDown",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Group|Connection)$/",
          "group": "2_manage@4"
        },
        {
          "command": "vault.deleteConnection",
          "when": "view == vaultExplorer && viewItem == vaultConnection",
          "group": "2_manage@5"
        },
        {
          "command": "vault.refresh",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Group|Connection|Mount|Folder)$/",
          "group": "3_search@0"
        },
        {
          "command": "vault.searchHere",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Connection|Mount|Folder)$/",
          "group": "3_search@1"
        },
        {
          "command": "vault.newSecret",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Mount|Folder)$/",
          "group": "4_edit@1"
        },
        {
          "command": "vault.deleteSecret",
          "when": "view == vaultExplorer && viewItem == vaultSecret",
          "group": "4_edit@2"
        },
        {
          "command": "vault.renamePath",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Folder|Secret)$/",
          "group": "4_edit@3"
        },
        {
          "command": "vault.deletePath",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Folder|Secret)$/",
          "group": "4_edit@4"
        },
        {
          "command": "vault.copyPath",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Folder|Secret)$/",
          "group": "5_copy@1"
        },
        {
          "command": "vault.copyTo",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Mount|Folder|Secret)$/",
          "group": "5_copy@2"
        },
        {
          "command": "vault.addToCompare",
          "when": "view == vaultExplorer && viewItem == vaultSecret",
          "group": "5_copy@3"
        },
        {
          "command": "vault.downloadPath",
          "when": "view == vaultExplorer && viewItem =~ /^vault(Mount|Folder)$/",
          "group": "5_copy@4"
        }
      ],
      "commandPalette": [
        {
          "command": "vault.openSecret",
          "when": "false"
        },
        {
          "command": "vault.deletePath",
          "when": "false"
        },
        {
          "command": "vault.renamePath",
          "when": "false"
        },
        {
          "command": "vault.copyPath",
          "when": "false"
        },
        {
          "command": "vault.copyTo",
          "when": "false"
        },
        {
          "command": "vault.addToCompare",
          "when": "false"
        },
        {
          "command": "vault.searchHere",
          "when": "false"
        },
        {
          "command": "vault.deleteSecret",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Vault Workbench",
      "properties": {
        "vault.defaultConnection": {
          "type": "string",
          "default": "",
          "description": "Display name of the default Vault connection to select on startup.",
          "scope": "application"
        },
        "vault.defaultMount": {
          "type": "string",
          "default": "",
          "description": "Default KV mount used when a connection does not specify one.",
          "scope": "application"
        },
        "vault.concurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 64,
          "description": "Maximum number of concurrent Vault requests during search and batch operations.",
          "scope": "application"
        },
        "vault.timeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Per-request timeout in milliseconds.",
          "scope": "application"
        },
        "vault.backupBeforeReplace": {
          "type": "boolean",
          "default": true,
          "description": "Store a local backup of each secret before it is modified by a batch replace.",
          "scope": "application"
        },
        "vault.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Read-only mode: disables all writes to Vault.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test:unit": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
